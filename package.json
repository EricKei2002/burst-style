{
  "name": "burst-style",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spell": "cspell .",
    "test:contact": "npx --yes tsx app/api/contact/validateContactForm.test.ts",
    "test:page-transition": "npx --yes tsx app/lib/pageTransitionTiming.test.ts",
    "test:solar": "npx --yes tsx app/lib/solar.test.ts",
    "test:local-sky": "npx --yes tsx app/lib/localSky.test.ts",
    "test:planets": "npx --yes tsx app/lib/planets.test.ts",
    "test:home-sections": "npx --yes tsx app/lib/homeSections.test.ts",
    "test:site-copy": "npx --yes tsx app/lib/siteCopy.test.ts",
    "test:transition-store": "npx --yes tsx app/lib/transitionStore.test.ts",
    "test:no-webgl": "node scripts/test-no-webgl.mjs",
    "test:sonta": "npx --yes tsx app/lib/sontaMotion.test.ts",
    "test": "npm run test:contact && npm run test:page-transition && npm run test:solar && npm run test:local-sky && npm run test:planets && npm run test:home-sections && npm run test:sonta && npm run test:site-copy && npm run test:transition-store",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.3",
    "@react-three/fiber": "^9.8.2",
    "@studio-freight/react-lenis": "^0.0.47",
    "@types/three": "^0.187.0",
    "gsap": "^3.15.1",
    "next": "^16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "resend": "^6.38.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cspell": "^10.5.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "lightningcss": "^1.30.2",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.1.18",
    "lightningcss-linux-x64-gnu": "^1.30.2"
  }
}
